<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TLS Monitor | Certificate Dashboard</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <script src="{{ url_for('static', filename='app.js') }}" defer></script>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon">T</div>
        <div>
          <h2>TLS Monitor</h2>
          <p>Certificate security</p>
        </div>
      </div>

      <nav class="sidebar-nav">
        <a href="#overview" class="nav-link active">Overview</a>
        <a href="#inventory" class="nav-link">Certificate Inventory</a>
        <a href="#activity" class="nav-link">Latest Check</a>
      </nav>

      <div class="sidebar-footer">
        <span class="live-dot"></span>
        Local monitoring
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div>
          <p class="eyebrow">SECURITY MONITORING</p>
          <h1>Certificate Dashboard</h1>
          <p class="subtitle">Monitor TLS certificate expiry across your domains.</p>
        </div>
        <button id="runCheckBtn" class="primary-btn" type="button">
          <span id="buttonLabel">Run Check</span>
        </button>
      </header>

      <section id="overview" class="status-banner">
        <div class="status-banner-icon">●</div>
        <div>
          <h3 id="overallTitle">Loading certificate status...</h3>
          <p id="overallMessage">Retrieving the latest report.</p>
        </div>
      </section>

      <section class="metrics-grid">
        <article class="metric-card">
          <p class="metric-label">Total Certificates</p>
          <h2 id="totalCount">—</h2>
          <p class="metric-note">Certificates monitored</p>
        </article>

        <article class="metric-card">
          <p class="metric-label">Healthy</p>
          <h2 id="healthyCount">—</h2>
          <p class="metric-note">Outside warning thresholds</p>
        </article>

        <article class="metric-card">
          <p class="metric-label">Warnings</p>
          <h2 id="warningCount">—</h2>
          <p class="metric-note">Approaching expiration</p>
        </article>

        <article class="metric-card">
          <p class="metric-label">Critical / Failed</p>
          <h2 id="criticalCount">—</h2>
          <p class="metric-note">Requires attention</p>
        </article>
      </section>

      <section id="inventory" class="panel">
        <div class="panel-header">
          <div>
            <h2>Certificate Inventory</h2>
            <p>Details reported by your existing Python checker.</p>
          </div>
          <div class="search-box">
            <input
              id="searchInput"
              type="search"
              placeholder="Search domains or issuers..."
              aria-label="Search certificates"
            >
          </div>
        </div>

        <div class="table-wrap">
          <table class="certificate-table">
            <thead>
              <tr>
                <th scope="col">Host / Port</th>
                <th scope="col">Issuer</th>
                <th scope="col">Expiration Date</th>
                <th scope="col">Days Left</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody id="certificateTableBody">
              <tr>
                <td colspan="5" class="empty-state">Loading certificates...</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div id="tableFooter" class="table-footer">Loading inventory...</div>
      </section>

      <section id="activity" class="panel activity-panel">
        <div class="panel-header">
          <div>
            <h2>Latest Check</h2>
            <p>Most recent report generated by the certificate checker.</p>
          </div>
        </div>

        <div class="activity-details">
          <div>
            <span class="detail-label">Last checked</span>
            <strong id="generatedAt">—</strong>
          </div>
          <div>
            <span class="detail-label">Overall result</span>
            <strong id="latestResult">—</strong>
          </div>
        </div>

        <pre id="checkOutput" class="check-output" hidden></pre>
      </section>

      <div id="toast" class="toast" role="status" aria-live="polite"></div>
    </main>
  </div>
</body>
</html><!DOCTYPE <html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TLS Monitor | Certificate Security</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">T</div>
            <div>
                <strong>TLS Monitor</strong>
                <span>Certificate Security</span>
            </div>
        </div>

        <p class="nav-label">WORKSPACE</p>
        <a class="nav-item active" href="/">▦ &nbsp; Overview</a>
        <a class="nav-item" href="#certificates">◈ &nbsp; Certificates</a>
        <a class="nav-item" href="#activity">◷ &nbsp; Check Activity</a>

        <div class="sidebar-bottom">
            <span class="status-dot"></span>
            <span>Local monitor</span>
            <small>WSL</small>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div>
                <p class="eyebrow">SECURITY / TLS</p>
                <h1>Certificate Overview</h1>
                <p class="subtitle">Monitor certificate health and expiration dates.</p>
            </div>
            <button id="runCheck" class="primary-button">
                <span>↻</span> Run Check
            </button>
        </header>

        <section class="status-banner" id="statusBanner">
            <div class="banner-icon">✓</div>
            <div>
                <strong id="overallTitle">Loading certificate status…</strong>
                <p id="overallMessage">Reading your latest checker report.</p>
            </div>
            <span class="live-tag"><span class="status-dot"></span> REPORT</span>
        </section>

        <section class="metrics">
            <article class="metric-card">
                <div class="metric-heading">Total Certificates <span>◈</span></div>
                <div class="metric-value" id="totalCount">—</div>
                <p>Certificates in latest report</p>
            </article>
            <article class="metric-card">
                <div class="metric-heading">Healthy <span class="green">✓</span></div>
                <div class="metric-value green" id="okCount">—</div>
                <p>Within safe expiry threshold</p>
            </article>
            <article class="metric-card">
                <div class="metric-heading">Expiring Soon <span class="yellow">◷</span></div>
                <div class="metric-value yellow" id="warningCount">—</div>
                <p>Warning threshold reached</p>
            </article>
            <article class="metric-card">
                <div class="metric-heading">Critical / Failed <span class="red">!</span></div>
                <div class="metric-value red" id="riskCount">—</div>
                <p>Needs immediate attention</p>
            </article>
        </section>

        <section class="panel" id="certificates">
            <div class="panel-heading">
                <div>
                    <h2>Certificate Inventory</h2>
                    <p>Details reported by your existing Python checker.</p>
                </div>
                <input id="searchInput" type="search"
                       placeholder="Search host or issuer…" aria-label="Search certificates">
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>HOST / PORT</th>
                            <th>ISSUER</th>
                            <th>EXPIRATION DATE</th>
                            <th>DAYS LEFT</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>
                    <tbody id="certificateRows">
                        <tr><td colspan="5" class="empty">Loading report…</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span id="resultCount">0 certificates</span>
                <span>Source: reports/report.json</span>
            </div>
        </section>

        <section class="panel activity" id="activity">
            <div class="panel-heading">
                <div>
                    <h2>Latest Check</h2>
                    <p>Most recent report and checker output.</p>
                </div>
                <span class="live-tag">LOCAL REPORT</span>
            </div>
            <div class="activity-details">
                <div>
                    <span class="detail-label">Report generated</span>
                    <strong id="generatedAt">Not available</strong>
                </div>
                <div>
                    <span class="detail-label">Thresholds</span>
                    <strong id="thresholds">Not available</strong>
                </div>
            </div>
            <pre id="checkOutput" class="output">No new check has been run in this session.</pre>
        </section>

        <footer>
            <span>TLS Certificate Expiry Monitor</span>
            <span>Powered by Python · Flask</span>
        </footer>
    </main>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script src="/static/app.js"></script>
</body>
</html>
